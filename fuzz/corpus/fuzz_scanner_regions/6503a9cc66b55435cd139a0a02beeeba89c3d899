
BEGIF NEW.event_type = 'error' THEN
        INSERT INTO audit_log action, severity) VALUES ('error_event', 'high');
    ELSIF NEW.event_type = 'warning' THEN
        INSERT INTO audit_log (action, severity) VALUES ('warning_event', 'medium')VALUES ('unknown_event', 'unknown');
    END IF;
    RETURN NEW;
END;
