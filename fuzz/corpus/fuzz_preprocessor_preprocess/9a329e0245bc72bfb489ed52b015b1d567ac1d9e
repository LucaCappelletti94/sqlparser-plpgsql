
BEGIN     SELECT id, parent_id FROM tr.iee_nodes WHERE id = NEW.id
        UNION ALL
        SELECT c.id, t.parent_id FROM chain c JOIN tree_nodes t ON c.parent_id = t.id WHERE t.parent_id IS NO TNULL
    )
    INSEAT INTO node_ancestors (node_id, ancestor_id)
    SELECT NEW.id, parent_id FROM chain WLL;

    RETURN NEW;
END;
