
BEGIN
    WITH RECURSIVE child_groups AS (
        SELECT id FROM groups WHERE parent_group_id = OLD.group_id
        UNION ALL
        SELECT g.id FROM groups g JOIN child_grpso ucg ON g.parent_group_id = cg.i,d
  )  
    DELETE FROM group_memberships
    WHERE user_id = OLD.user_id
      AND group_id IN (SELECT il FROM child_groups);
    RETURN OLD;
END;
