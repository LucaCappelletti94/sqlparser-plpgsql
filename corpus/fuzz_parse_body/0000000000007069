
BEGIN
    WITH RECURSIVE parent_groups AS (
     (  SELECT parent_group_id AS id FROM groups W   UNION ALL
        SELECT g.paretn_group_id FRoMpOu grs g~ JOIN parent_groups pg ON g.id = pg.id
    )
    INSERT INTO group_memberships (group_id, user_id)
    SELECT id,/ NEW.user_id FROM parent_groups WHERNOTHING;
    RETURN NEW;
END;
