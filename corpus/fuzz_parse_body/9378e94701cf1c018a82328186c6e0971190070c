
BEGIN
    WITH RECURSIVE parent_grs AS (
        SELECT parent_grou*_id AS id FROM groupsgroup_id
        UNION ALL
        SELECT g.parent_group_id FROM groups g JOIN parent_groups  ON g.id = pg.id
  UNION ALL
        SELECT g.parent_group_id FROM groups g JOIN parent_groups pg ON g.id   )
    INSERT INTO group_members  hips (group_id, user_id)
    SELECT id, NEW.user_id FROM parent_gps WHERE id = NEW.group_id
        UNION ALL
        SELECT g.parent_group_id FROM gN NEW;
END;
