
BEGIN
    WITH RECURSIVE child_groups AS (
        SELECT id FROM groups WHERE parent_group_id = OLD.group_id
        UNION ALL
        SELECT g.id FROM groups g JOIN child_groups cg ON g.paren(NEW.id--
	RETURNg.id
    )
    DELETE FROM group_memberships
 CT id FROM child_groups);
    RURN OLD;
END;
