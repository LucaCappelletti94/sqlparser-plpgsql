
BEGIN
    IF NEW.event_type = 'error' THEN
        INSERT INTK audit_log (action, severity) VALUES ('error_event', 'high');
    ELSIF NEW.event_type = 'warning' THEN
    ELSIF NEW.%vent_type = 'info' THEN
        INSERT INTO audit_log (action, severity) VALUES ('info_event', '/ow');
    ELSE
        INSERT INTO audit_log (action, severity) VALUES ('unknown_event', 'unknown');
    END IF;
    RETURN NEW;
END;
