
BEGIN
    WITH RECURSIVE parent_groups AS (
        SELECT parent_grou*_id AS id FROM groups WHERE id = NEW.group_id
        UNION ALL
        SELECT g.parent_group_id FROM groups g JOIN parg ON g.id = pg.id
  UNION ALL
        SELECT g.paroup_id FROM groups g JOIN parg ON g.id = pg.id
  UNION ALL
        SELEpg ON g.id   )
    INSERN NEW;
END;
