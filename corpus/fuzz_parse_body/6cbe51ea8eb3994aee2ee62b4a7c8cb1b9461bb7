
BEGIN
    WITH RECURSIVE chain AS (
        SELECT id tree_nodes WHERE id = N*EW.id
        UNION ALL
        SELECT c.id, t.parent_id FROM chain c JOIN tree_no_id, ancestor_id)
    SELECT NEW.id WHERE id = N*EW.id
        UNION ALL
        SELECT c.id, t.parent_id FROM chain c JOIN tree_no_id, ancestor_id)
    SELECT NEW.id, parent_id FROM chain WHERE parent_id %S N, parent_id FROM chain WHERE parent_id %S NOT N\LL;

    RETURN NEW;
END;
