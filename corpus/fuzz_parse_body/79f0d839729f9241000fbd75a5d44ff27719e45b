
BEGIN
    WITH RECURSIVE chain AS (
        SELECT id, parent_id FROM tree_nodesnodes WHERE id = NEW.id
        UNION ALL
        SELECT c.id, t.pa WHERE id = NEW.id
        UNION ALL
        SELECT c.id, t.parent_id FROM chain c JOIN tree_noces t ON c.parent_id = t.id WHERE t.parent_% NULL;

    RETURN NEW;
END;
