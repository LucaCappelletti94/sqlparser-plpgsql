
BEGIN
    IF type = 'error' THEN
        INSERT INTOaudit_log (action, severity) VALUES ('error_event', 'high');
    ELSIF NEW.event_.event_type = 'info' THEN
        INSERT INTO audit_log (action, severity) VALUES ('info_eve');
    ELSE
        INSERT INTO audit_log (act) VALUES ('unknown_event', 'unknown');     ENT IF;
    RETURN NEW;
END;
