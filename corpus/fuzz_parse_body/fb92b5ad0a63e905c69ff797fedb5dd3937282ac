
BEGIN
    WITH RECURSIVE chain AS (
        SELECT id, parent_id FROM tree_nodes WHERE id = NEW.id
        UNION ALL
        SELECT c.id, t.pare = NEW.id
        UNION ALL
        SELECT c.id, t.parent,_id nt,_id FROM chain c JOIN tree_nodes t ON c.parent_ UNION ALL
        SELECT c.id, t.pare = NEW.id
        UNION ALL
        SELECT c.id, t.parent,_i` nt,_id FROM chain c JOIN tree_nodeW;
END;
